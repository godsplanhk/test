  ri_share_id   Int?
  ig_comment_id Int?
  fb_comment_id Int?
  tt_comment_id Int?
  li_comment_id Int?
  ri_comment_id Int?
  ig_post_id    Int?
  fb_post_id    Int?
  tt_post_id    Int?
  li_post_id    Int?
  ri_post_id    Int?
  fb_comment    fb_comment? @relation(fields: [fb_comment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fb_like       fb_like?    @relation(fields: [fb_like_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fb_message    fb_message? @relation(fields: [fb_message_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fb_post       fb_post?    @relation(fields: [fb_post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fb_share      fb_share?   @relation(fields: [fb_share_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ig_comment    ig_comment? @relation(fields: [ig_comment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ig_like       ig_like?    @relation(fields: [ig_like_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ig_message    ig_message? @relation(fields: [ig_message_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ig_post       ig_post?    @relation(fields: [ig_post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ig_share      ig_share?   @relation(fields: [ig_share_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  li_comment    li_comment? @relation(fields: [li_comment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  li_like       li_like?    @relation(fields: [li_like_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  li_message    li_message? @relation(fields: [li_message_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  li_post       li_post?    @relation(fields: [li_post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  li_share      li_share?   @relation(fields: [li_share_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ri_comment    ri_comment? @relation(fields: [ri_comment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ri_like       ri_like?    @relation(fields: [ri_like_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ri_message    ri_message? @relation(fields: [ri_message_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ri_post       ri_post?    @relation(fields: [ri_post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ri_share      ri_share?   @relation(fields: [ri_share_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tt_comment    tt_comment? @relation(fields: [tt_comment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tt_like       tt_like?    @relation(fields: [tt_like_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tt_message    tt_message? @relation(fields: [tt_message_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tt_post       tt_post?    @relation(fields: [tt_post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tt_share      tt_share?   @relation(fields: [tt_share_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
