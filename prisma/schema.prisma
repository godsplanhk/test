model quota {
  user_id       String      @id
  quota_data    Json        @db.Json
  ig_message_id Int?
  fb_message_id Int?
  tt_message_id Int?
  li_message_id Int?
  ri_message_id Int?
  ig_like_id    Int?
  fb_like_id    Int?
  tt_like_id    Int?
