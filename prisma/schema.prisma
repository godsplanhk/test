generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SocialMediaLog {
  id              Int      @id @default(autoincrement())
  taskTitle       String
  taskDescription String?
  lastModified    DateTime @default(now())
  status          String   @default("Pending")
  timeLeft        Int?
  memoryUsed      String?
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id              String     @id
  full_name       String     @db.VarChar(255)
  username        String     @unique @db.VarChar(255)
  email           String     @unique @db.VarChar(255)
  password        String?    @db.VarChar(255)
  profile_picture String?    @db.VarChar(255)
  created_at      DateTime?  @default(now()) @db.Timestamp(6)
  updated_at      DateTime?  @db.Timestamp(6)
  image           String?
  emailVerified   DateTime?
  Account         Account[]
  Session         Session[]
  accounts        accounts[]
  agent           agent[]
  quota           quota?
  task            task[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model accountAssociation {
  account_id Int
  devices_id Int

  @@id([account_id, devices_id])
}

model accounts {
  id           Int          @id @default(autoincrement())
  platforms_id Int
  username     String       @unique @db.VarChar(255)
  password     String       @db.VarChar(255)
  warmup_time  Int          @default(4320)
  created_at   DateTime?    @default(now()) @db.Timestamp(6)
  user_id      String?
  platforms    platforms    @relation(fields: [platforms_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User         User?        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  agent        agent[]
  fb_comment   fb_comment[]
  fb_like      fb_like[]
  fb_message   fb_message[]
  fb_post      fb_post[]
  fb_share     fb_share[]
  ig_comment   ig_comment[]
  ig_like      ig_like[]
  ig_message   ig_message[]
  ig_post      ig_post[]
  ig_share     ig_share[]
  li_comment   li_comment[]
  li_like      li_like[]
  li_message   li_message[]
  li_post      li_post[]
  li_share     li_share[]
  ri_comment   ri_comment[]
  ri_like      ri_like[]
  ri_message   ri_message[]
  ri_post      ri_post[]
  ri_share     ri_share[]
  tt_comment   tt_comment[]
  tt_like      tt_like[]
  tt_message   tt_message[]
  tt_post      tt_post[]
  tt_share     tt_share[]
}

model agent {
  id                    Int       @id @default(autoincrement())
  platforms_id          Int
  user_id               String
  account_id            Int
  num_account_purchased Int
  accounts              accounts  @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  platforms             platforms @relation(fields: [platforms_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User                  User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model devices {
  id                  Int     @id @default(autoincrement())
  availability_status Boolean
  serial_number       String?
}

